
.page {
    --docs-rail: 288px;
    --docs-bar: 59px;

  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  color: var(--text);
}

.barOuter {
  position: sticky;
  top: var(--header-height);
  z-index: 40;
  flex: none;
  background: var(--bg);
  border-bottom: 1px solid var(--border);
}

.bar {
  display: flex;
  align-items: center;
  gap: 20px;
  width: min(var(--content-max), calc(100% - 48px));
  margin: 0 auto;
  padding: 18px 0 16px;
}

.title {
  margin: 0;
  font-size: 21px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.15;
}

.tabs {
  display: inline-flex;
  padding: 3px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface-muted);
}

.tab {
  padding: 5px 11px;
  border-radius: 999px;
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 530;
  text-decoration: none;
  white-space: nowrap;
}

.tab:hover {
  color: var(--text);
}

.tabOn,
.tabOn:hover {
  background: var(--surface);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

.tab:focus-visible {
  outline: none;
  box-shadow: var(--ring);
}


.shell {
  flex: 1 1 auto;
  display: flex;
  align-items: stretch;
  width: min(var(--content-max), calc(100% - 48px));
  margin: 0 auto;
}

.rail {
  flex: none;
  width: var(--docs-rail);
  padding: 28px 24px 48px 0;
  border-right: 1px solid var(--border);
}

.railInner {
  position: sticky;
  top: calc(var(--header-height) + var(--docs-bar) + 24px);
  max-height: calc(100vh - var(--header-height) - var(--docs-bar) - 48px);
  overflow-y: auto;
  overscroll-behavior: contain;
}

.body {
  flex: 1 1 0;
  min-width: 0;
}

.body p {
  text-wrap: pretty;
}

.group + .group {
  margin-top: 22px;
}

.groupTitle {
  padding: 0 10px 8px;
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.navLink {
  display: block;
  padding: 6px 10px;
  border-radius: 6px;
  color: var(--text-secondary);
  font-size: 13px;
  text-decoration: none;
}

.navLink:hover {
  background: var(--surface-muted);
  color: var(--text);
}

.navLinkOn,
.navLinkOn:hover {
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 550;
}

.navLink:focus-visible {
  outline: none;
  box-shadow: var(--ring);
}


.scalar {
  flex: 1 1 auto;
  min-height: 0;
  width: min(var(--content-max), calc(100% - 48px));
  margin: 0 auto;
}

.fallback {
  width: min(560px, 100%);
  padding: 48px 0;
  margin: 0 auto;
}

.fallbackTitle {
  margin: 0;
  font-size: 20px;
  font-weight: 680;
  letter-spacing: -0.01em;
}

.fallbackBody {
  margin: 14px 0 0;
  color: var(--text-secondary);
  font-size: 15px;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.link {
  color: var(--accent);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 120ms ease;
}

.link:hover {
  border-bottom-color: currentColor;
}


.prose {
  width: min(660px, 100%);
  padding: 32px 40px 88px;
  box-sizing: content-box;
}

.lead {
  margin: 0;
  font-size: 17px;
  line-height: 1.65;
}

.heading {
  margin: 0;
  font-size: 22px;
  font-weight: 680;
  letter-spacing: -0.02em;
  line-height: 1.25;
  scroll-margin-top: calc(var(--header-height) + var(--docs-bar) + 20px);
}

.subheading {
  margin: 26px 0 0;
  font-size: 15px;
  font-weight: 650;
  scroll-margin-top: calc(var(--header-height) + var(--docs-bar) + 20px);
}

.bodyText {
  margin: 14px 0 0;
  color: var(--text-secondary);
  font-size: 15px;
  line-height: 1.65;
}

.pre {
  margin: 14px 0 0;
  padding: 12px 14px;
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface-muted);
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 12.5px;
  line-height: 1.55;
  white-space: pre;
}

.code {
  padding: 1px 5px;
  border-radius: 4px;
  background: var(--surface-muted);
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 0.88em;
}

.flags {
  margin: 14px 0 0;
  padding-left: 20px;
  color: var(--text-secondary);
  font-size: 15px;
  line-height: 1.65;
}

.flags li + li {
  margin-top: 10px;
}


@media (max-width: 900px) {
  .bar {
    width: calc(100% - 28px);
  }


  .shell {
    width: calc(100% - 28px);
  }

  .rail {
    display: none;
  }

  .prose {
    width: 100%;
    padding: 28px 0 64px;
  }

  .heading {
    font-size: 20px;
  }
}

@media (max-width: 520px) {
  .bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
}
