# Settings shared by the browser-test stack: compose.yml, the website Makefile,
# seed.sql and playwright.config.ts all read this file.
# Everything here is for a throwaway local stack. None of it is a real credential.

BROWSER_DB_PORT=35442
BROWSER_DB_NAME=dynamic_pdb_browser
BROWSER_DB_USER=postgres
BROWSER_DB_PASSWORD=password

BROWSER_S3_PORT=39090
BROWSER_S3_BUCKET=dynamic-pdb

BROWSER_BACKEND_PORT=18890
BROWSER_WEBSITE_PORT=3890
# e2e/stack/fake-rcsb.mjs, in place of RCSB and SIFTS.
BROWSER_RCSB_PORT=18891

BROWSER_JWT_SECRET=browser-tests-only-jwt-secret
BROWSER_JWT_ISSUER=dynamic-pdb-backend

# The two users seed.sql creates: a depositor with no role, and a reviewer.
BROWSER_SUBMITTER_ID=6b3f2a8e-0d4c-4e8a-9a51-2f1c7d9e0a01
BROWSER_REVIEWER_ID=6b3f2a8e-0d4c-4e8a-9a51-2f1c7d9e0a02
